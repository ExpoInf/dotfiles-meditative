// Based on exmaple 14.jsonc - Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 2
        },
        "color": {
        "1": "#32a852",
        "2": "#818281"
    }
    },
    "display": {
        "separator": " ",
        "constants": [
            "───────────"
        ],
        "key": {
            "width": 18,
            "color": "90" // This turns all module keys grey globally
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#90}┌{$1} Hardware {$1}{$1}{$1}┐{#}"
        },
        {
            "type": "cpu",
            "key": " CPU",
            "format": "{name} @ {freq-max}",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "󰡀 GPU",
            "format": "{name} @ {frequency}"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "format": "{inch}in, {width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk (/)",
            "format": "{size-used} / {size-total} {size-percentage}",
            "show-all": true,
        },
        {
            "type": "memory",
            "key": " Memory"
        },
        {
            "type": "swap",
            "key": "󰯍 Swap"
        },
        {
            "type": "custom",
            "format": "{#90}└{$1}─────────────────────{$1}{$1}┘{#}"
        },
        {
            "type": "custom",
            "format": "{#90}┌{$1} Software {$1}{$1}{$1}┐{#}"
        },
        {
            "type": "os",
            "key": "  OS",
            "format": "{name} {version}"
        },
        {
            "type": "kernel",
            "key": "  Kernel"
        },
        {
          "type": "packages",
          "key": "  Packages"
        },
        {
            "type": "lm",
            "key": "  DM"
        },
        {
            "type": "de",
            "key": "  DE"
        },
        {
            "type": "wm",
            "key": "  WM"
        },
        {
            "type": "theme",
            "key": "  Theme"
        },
        {
            "type": "icons",
            "key": "  Icons"
        },
        {
            "type": "terminalfont",
            "key": "  Font",
            "format": "{name}"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "custom",
            "format": "{#90}└{$1}─────────────────────{$1}{$1}┘{#}"
        }
    ]
}
